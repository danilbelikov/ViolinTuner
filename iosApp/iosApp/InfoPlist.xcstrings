{
  "sourceLanguage": "en",
  "strings": {
    "NSCameraUsageDescription": {
      "comment": "The same words as camera_permission_text of the shared resources; written by tools/ios/infoplist.py.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kamera fotografiert Noten und filmt Video-Takes. Die Aufnahmen bleiben auf dem Telefon und werden nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The camera takes photos of sheet music and video takes. They stay on the phone and are not sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cámara fotografía las partituras y graba las tomas en vídeo. Se quedan en el teléfono y no se envían a ningún sitio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La caméra photographie les partitions et filme les prises vidéo. Elles restent sur le téléphone et ne sont envoyées nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La fotocamera fotografa gli spartiti e riprende le prese video. Restano sul telefono e non vengono inviate da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カメラで楽譜の写真とビデオテイクを撮影します。撮影したものは端末に残り、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카메라로 악보 사진과 영상 테이크를 찍어요. 촬영한 것은 휴대폰에만 남고 어디로도 보내지지 않아요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "A câmera fotografa as partituras e grava os takes em vídeo. Eles ficam no telefone e não são enviados a lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Камера снимает фото нот и видео-дубли. Снимки остаются на телефоне и никуда не отправляются."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "相机用于拍摄乐谱照片和视频录制。拍摄内容只保存在手机上，不会发送到任何地方。"
          }
        }
      }
    },
    "NSMicrophoneUsageDescription": {
      "comment": "The same words as mic_permission_text of the shared resources; written by tools/ios/infoplist.py.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Mikrofon hört die App die Geige nicht. Der Klang wird auf dem Telefon verarbeitet und nirgendwohin gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without the microphone the app cannot hear the violin. Sound is processed on the phone and is never sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin micrófono la aplicación no oye el violín. El sonido se procesa en el teléfono y no se envía a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans micro, l'application n'entend pas le violon. Le son est traité sur le téléphone et n'est envoyé nulle part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza microfono l'app non sente il violino. Il suono viene elaborato sul telefono e non viene inviato da nessuna parte."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイクがないと、ヴァイオリンの音を聴き取れません。音はこの端末内で処理され、どこにも送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크가 없으면 바이올린 소리를 들을 수 없어요. 소리는 휴대폰에서만 처리되며 어디로도 전송되지 않습니다."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem o microfone, o app não ouve o violino. O som é processado no telefone e não é enviado a lugar nenhum."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без микрофона тренажёр не слышит скрипку. Звук обрабатывается на телефоне и никуда не отправляется."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有麦克风，应用就听不到小提琴。声音只在手机上处理，不会发送到任何地方。"
          }
        }
      }
    },
    "NSPhotoLibraryAddUsageDescription": {
      "comment": "The same words as photos_add_permission_text of the shared resources; written by tools/ios/infoplist.py.",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Video, das Sie über „Teilen“ speichern, kommt in „Fotos“. Die App fügt es nur hinzu und sieht den Rest Ihrer Mediathek nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A video you save from “Share” goes to Photos. The app only adds it and does not see the rest of your library."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un vídeo guardado desde «Compartir» va a «Fotos». La app solo lo añade y no ve el resto de la fototeca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une vidéo que vous enregistrez depuis « Partager » va dans « Photos ». L'app se contente de l'ajouter et ne voit pas le reste de votre photothèque."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un video salvato da «Condividi» finisce in «Foto». L'app lo aggiunge soltanto e non vede il resto della libreria."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「共有」から保存した動画は「写真」に入ります。アプリは動画を追加するだけで、ライブラリのほかの内容は見えません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“공유”에서 저장한 영상은 “사진”에 들어가요. 앱은 영상을 추가하기만 하고 나머지 보관함은 보지 못해요."
          }
        },
        "pt": {
          "stringUnit": {
            "state": "translated",
            "value": "Um vídeo salvo a partir de “Compartilhar” vai para “Fotos”. O app só o adiciona e não vê o resto da biblioteca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Видео, которое вы сохраняете из «Поделиться», попадает в «Фото». Приложение только добавляет его и не видит остальную галерею."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从“分享”保存的视频会存入“照片”。应用只会添加视频，看不到图库中的其他内容。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
