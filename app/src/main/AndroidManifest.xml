<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- «Снять под минусовку» (spec 3.32): asked for at the first shot; without a camera the app still installs -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <!-- A copy of gigabytes takes minutes (spec 3.20): a foreground service keeps the process alive
         meanwhile. Normal permissions — the person is asked nothing. POST_NOTIFICATIONS is declared
         so that the progress can be shown to whoever allows it in the system settings, and is never
         requested: without it the system shows nothing, and the work goes on all the same. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Anonymous statistics (spec 3.34). The analytics library declares these two in its own
         manifest; they are repeated here because this is where the app's permissions are read. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Its identifiers module also asks for the advertising id. The app shows no ads and measures
         no campaigns, and without this permission what it collects cannot be tied to a person
         across apps — that is what makes the statistics anonymous rather than merely called so. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".ViolinTunerApp"
        android:localeConfig="@xml/locales_config"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ViolinTuner">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name_launcher"
            android:theme="@style/Theme.ViolinTuner"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <service
            android:name=".core.backup.BackupService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Lends the system camera a file to write a photo of sheet music or a video into (spec 3.15,
             3.19), and other apps a file to receive through «Поделиться». -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- The analytics library brings an exported provider for tracking preinstallations. The app
             is installed from a store and never preinstalled, so the provider is dropped rather
             than left exported (spec 5.27). -->
        <provider
            android:name="io.appmetrica.analytics.internal.PreloadInfoContentProvider"
            android:authorities="${applicationId}.appmetrica.preloadinfo.retail"
            tools:node="remove" />
    </application>

</manifest>