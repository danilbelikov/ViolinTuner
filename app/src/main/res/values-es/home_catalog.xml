    <string name="home_item_stand_candle_note" formatted="false">Por la tarde las velas arden. De día, solo están.</string>
    <string name="home_item_metronome_note" formatted="false">El péndulo oscila siempre. En silencio.</string>
    <string name="home_item_notes_note" formatted="false">Todo lo ya leído y lo que aún no.</string>
    <string name="home_item_portrait_note" formatted="false">Un óvalo, como en el conservatorio. Quién es, lo decides tú.</string>
    <string name="home_item_poster_note" formatted="false">La fecha aún no está fijada. El lugar, sí.</string>
    <string name="home_item_postcards_note" formatted="false">Las que ya están abiertas. Aparecen solas, una por ciudad.</string>
    <string name="home_item_shelf_scores_note" formatted="false">Lomos en fila. Huele a papel.</string>
    <string name="home_item_gramophone_note" formatted="false">La bocina mira a la habitación. No suena: principio 2.</string>
    <string name="home_item_radio_note" formatted="false">De válvulas, de madera cálida. Calla.</string>
    <string name="home_item_piano_note" formatted="false">El segundo instrumento. La tapa abierta, la partitura puesta.</string>
    <string name="home_item_cello_note" formatted="false">Apoyado en la pared. A veces apetece.</string>
    <string name="home_item_guitar_note" formatted="false">Para los días en que los dedos piden otra cosa.</string>
    <string name="home_item_wp_plum_note" formatted="false">Las que hay.</string>
    <string name="home_item_wp_warm_note" formatted="false">Lisas, un poco cálidas.</string>
    <string name="home_item_wp_cool_note" formatted="false">Luz del norte.</string>
    <string name="home_item_wp_green_note" formatted="false">Como el terciopelo de un palco.</string>
    <string name="home_item_wp_stripe_note" formatted="false">Raya fina, algo más clara que el fondo.</string>
    <string name="home_item_wp_damask_note" formatted="false">Lirios con volutas, un tono más claros que el fondo.</string>
    <string name="home_item_wp_floral_note" formatted="false">Flores como puntos, rosas sobre cálido.</string>
    <string name="home_item_wp_notes_note" formatted="false">Notas menudas por la pared. No forman ninguna melodía, y mejor así.</string>
    <string name="home_item_wp_panels_note" formatted="false">Hasta media pared, madera; más arriba, pared.</string>
    <string name="home_item_floor_plank_note" formatted="false">La tabla oscura de una habitación alquilada.</string>
    <string name="home_item_floor_light_note" formatted="false">Pino, casi miel.</string>
    <string name="home_item_floor_dark_note" formatted="false">Casi negro, brilla junto a la ventana.</string>
    <string name="home_item_floor_herring_note" formatted="false">Como en los pisos antiguos.</string>
    <string name="home_item_floor_tile_note" formatted="false">Frescas, de cocina.</string>
    <string name="home_item_curtain_plum_note" formatted="false">Las que cuelgan.</string>
    <string name="home_item_curtain_velvet_note" formatted="false">Como el telón de La Scala.</string>
    <string name="home_item_curtain_sand_note" formatted="false">Cálidas, de lino.</string>
    <string name="home_item_curtain_teal_note" formatted="false">Un verde azulado profundo.</string>
    <string name="home_item_curtain_tulle_note" formatted="false">Ligero, deja pasar la luz.</string>
    <string name="home_item_blinds_note" formatted="false">De madera, en franjas de luz.</string>
    <string name="home_item_window_simple_note" formatted="false">La cruz del marco, como estaba.</string>
    <string name="home_item_window_arched_note" formatted="false">Como si el techo fuera más alto.</string>
    <string name="home_item_window_stained_note" formatted="false">Vidrios de colores sobre la vista: la vista se adivina.</string>
    <string name="home_item_view_city_note" formatted="false">Los tejados de enfrente. Por la tarde, la luna.</string>
    <string name="home_item_view_sea_note" formatted="false">El horizonte y una sola vela.</string>
    <string name="home_item_view_mount_note" formatted="false">Nieve en las cumbres todo el año.</string>
    <string name="home_item_view_garden_note" formatted="false">Un césped y dos árboles.</string>
    <string name="home_item_view_night_note" formatted="false">Ventanas hasta el cielo. De día, solo cristal.</string>
    <string name="home_item_garland_note" formatted="false">Titila por la tarde. No solo en invierno.</string>
    <string name="home_item_lamp_table_note" formatted="false">La que ya estaba. Alumbra por la tarde.</string>
    <string name="home_item_lamp_brass_note" formatted="false">Metal cálido, luz cálida.</string>
    <string name="home_item_floorlamp_note" formatted="false">En su rincón, lee contigo.</string>
    <string name="home_item_chandelier_note" formatted="false">Cinco velas en círculo. Por la tarde arden.</string>
    <string name="home_item_candles_note" formatted="false">Tres, de distinta altura. Por la tarde, vivas.</string>
    <string name="home_item_fireplace_note" formatted="false">Solo en una casa con chimenea. Por la tarde arde; de día, leña.</string>
    <string name="home_item_desk_simple_note" formatted="false">Cuatro patas y un tablero.</string>
    <string name="home_item_desk_oak_note" formatted="false">Tablero grueso, tirador de latón.</string>
    <string name="home_item_bureau_note" formatted="false">Una mesa sobre la que creció una pared de cajoncitos.</string>
    <string name="home_item_chair_simple_note" formatted="false">De madera, cruje un poco.</string>
    <string name="home_item_armchair_note" formatted="false">Hondo, tapizado en tela. El gato lo sabrá apreciar.</string>
    <string name="home_item_rocking_note" formatted="false">Se mece sola, apenas. Siempre.</string>
    <string name="home_item_plaid_note" formatted="false">Doblada, con flecos. Espera a la tarde.</string>
    <string name="home_item_pouf_note" formatted="false">Para sentarse un minuto con la partitura.</string>
    <string name="home_item_bookshelf_note" formatted="false">No llega al techo, pero casi.</string>
    <string name="home_item_commode_note" formatted="false">Tres cajones. En el de arriba, las cuerdas.</string>
    <string name="home_item_mirror_note" formatted="false">Para revisar la posición de las manos.</string>
    <string name="home_item_clock_note" formatted="false">El péndulo oscila. Las agujas marcan tu hora.</string>
    <string name="home_item_rug_plum_note" formatted="false">Sencilla, a tono con las paredes. La primera y barata.</string>
    <string name="home_item_rug_persian_note" formatted="false">Granate, con cenefa.</string>
    <string name="home_item_rug_stripe_note" formatted="false">Tejida a mano, a rayas.</string>
    <string name="home_item_rug_round_note" formatted="false">Pequeña, cálida.</string>
    <string name="home_item_rug_green_note" formatted="false">Como la hierba del jardín.</string>
    <string name="home_item_ficus_note" formatted="false">Crece despacio, pero no se marchita nunca.</string>
    <string name="home_item_monstera_note" formatted="false">Hojas caladas, del tamaño de una mano.</string>
    <string name="home_item_tulips_note" formatted="false">Tres. No se marchitan: principio del juego tranquilo.</string>
    <string name="home_item_vase_note" formatted="false">Flores silvestres. O del jardín bajo la ventana.</string>
    <string name="home_item_xmas_note" formatted="false">De temporada: de diciembre a enero se pone solo, si está comprado.</string>
    <string name="home_item_tea_note" formatted="false">Siempre humea. No se enfría.</string>
    <string name="home_item_books_note" formatted="false">Tres. Uno, sobre el violín.</string>
    <string name="home_item_passport_note" formatted="false">Descansa en la mesa cuando no está de viaje.</string>
    <string name="home_item_globe_note" formatted="false">Una banderita en cada ciudad donde has estado. Se ponen solas.</string>
    <string name="home_item_cat_ginger_note" formatted="false">Duerme en el alféizar. Respira, parpadea de vez en cuando. No hay que darle de comer.</string>
    <string name="home_item_cat_black_note" formatted="false">Solo se le ven los ojos, y no siempre.</string>
    <string name="home_item_cat_grey_note" formatted="false">Rayas a tono con el suelo.</string>
    <string name="home_item_cat_white_note" formatted="false">Sobre la alfombra oscura, como una mancha de luz.</string>
    <string name="home_item_dog_note" formatted="false">Tumbado a los pies. A veces levanta la cabeza.</string>
    <string name="home_item_turtle_note" formatted="false">La más silenciosa de todos. A veces se mueve; no lo notarás.</string>
