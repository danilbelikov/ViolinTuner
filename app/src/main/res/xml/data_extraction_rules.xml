<?xml version="1.0" encoding="utf-8"?>
<!-- The same as backup_rules.xml, for API 31 and up. A cable transfer between two phones has no such limit and takes everything. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="sessions/" />
        <exclude domain="file" path="repertoire/" />
        <exclude domain="file" path="backings/" />
        <exclude domain="file" path="waveforms/" />
        <exclude domain="file" path="restore-staging/" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="waveforms/" />
        <exclude domain="file" path="restore-staging/" />
    </device-transfer>
</data-extraction-rules>
