<?xml version="1.0" encoding="utf-8"?>
<!--
  The system's own backup holds 25 MB an app and fails as a whole when there is more: with videos
  there are gigabytes (spec 5.14). So it takes what is small and matters most — the database and
  the settings — and leaves the sound, the videos, the sheets and the backing tracks to the copy the person makes.
  The marks of a restore live until the next start of this app on this phone: on another phone «restore-wipe» would
  wipe the data that had just come over, so neither mark goes anywhere.
-->
<full-backup-content>
    <exclude domain="file" path="sessions/" />
    <exclude domain="file" path="repertoire/" />
    <exclude domain="file" path="backings/" />
    <exclude domain="file" path="waveforms/" />
    <exclude domain="file" path="restore-staging/" />
    <exclude domain="file" path="restore-ready" />
    <exclude domain="file" path="restore-wipe" />
</full-backup-content>
