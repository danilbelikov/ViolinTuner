    <string name="home_item_vln_student_note" formatted="false">Regalo della bottega: il violino esce dalla custodia, alla luce.</string>
    <string name="home_item_vln_quarter_note" formatted="false">Proprio quello con cui tutto è cominciato. Piccolo.</string>
    <string name="home_item_vln_light_note" formatted="false">La vernice non si è ancora scurita — non ha ancora suonato come si deve.</string>
    <string name="home_item_vln_master_note" formatted="false">Una sola bottega, un solo paio di mani, sei mesi di lavoro.</string>
    <string name="home_item_vln_electric_note" formatted="false">Un telaio al posto della cassa. Non si capisce subito che è un violino.</string>
    <string name="home_item_vln_old_note" formatted="false">Duecento anni di mani altrui. La vernice è quasi nera.</string>
    <string name="home_item_vln_cremona_note" formatted="false">Acero fiammato sul fondo. Ha un nome, ma non lo si pronuncia.</string>
    <string name="home_item_case_black_note" formatted="false">Quella di sempre. Sta aperta vicino alla finestra.</string>
    <string name="home_item_case_velvet_note" formatted="false">Fuori sobria, dentro — ciliegia.</string>
    <string name="home_item_case_carbon_note" formatted="false">Leggera come un astuccio per occhiali.</string>
    <string name="home_item_case_leather_note" formatted="false">Adesivi delle città dove sei già stato. Compaiono da soli.</string>
    <string name="home_item_stand_fold_note" formatted="false">Di metallo, come a scuola.</string>
    <string name="home_item_stand_concert_note" formatted="false">Nero, pesante, con il ripiano largo.</string>
    <string name="home_item_stand_wood_note" formatted="false">Una lira nell\'intaglio. Da una bottega di Vienna.</string>
    <string name="home_item_stand_candle_note" formatted="false">La sera le candele sono accese. Di giorno stanno lì e basta.</string>
    <string name="home_item_metronome_note" formatted="false">Il pendolo oscilla sempre. In silenzio.</string>
    <string name="home_item_notes_note" formatted="false">Tutto ciò che è stato letto e ciò che ancora no.</string>
    <string name="home_item_portrait_note" formatted="false">Un ovale, come in conservatorio. Chi sia, decidilo tu.</string>
    <string name="home_item_poster_note" formatted="false">La data non è ancora fissata. Il luogo si sa.</string>
    <string name="home_item_postcards_note" formatted="false">Quelle già sbloccate. Compaiono da sole, una per città.</string>
    <string name="home_item_shelf_scores_note" formatted="false">Dorsi in fila. Profumo di carta.</string>
    <string name="home_item_gramophone_note" formatted="false">La tromba guarda verso la stanza. Non suona — principio 2.</string>
    <string name="home_item_radio_note" formatted="false">A valvole, di legno caldo. Tace.</string>
    <string name="home_item_piano_note" formatted="false">Il secondo strumento. Coperchio aperto, spartito sul leggio.</string>
    <string name="home_item_cello_note" formatted="false">Sta appoggiato alla parete. A volte viene voglia.</string>
    <string name="home_item_guitar_note" formatted="false">Per i giorni in cui le dita vogliono altro.</string>
    <string name="home_item_wp_plum_note" formatted="false">Quelle che ci sono.</string>
    <string name="home_item_wp_warm_note" formatted="false">Tinta unita, appena calde.</string>
    <string name="home_item_wp_cool_note" formatted="false">Luce del nord.</string>
    <string name="home_item_wp_green_note" formatted="false">Come il velluto di un palco.</string>
    <string name="home_item_wp_stripe_note" formatted="false">Righe sottili, appena più chiare del fondo.</string>
    <string name="home_item_wp_damask_note" formatted="false">Rombi con volute — qui, rombi.</string>
    <string name="home_item_wp_floral_note" formatted="false">Fiori a puntini, rosa su fondo caldo.</string>
    <string name="home_item_wp_notes_note" formatted="false">Piccole note sulla parete. Non formano una melodia — e va bene così.</string>
    <string name="home_item_wp_panels_note" formatted="false">Fino a metà parete legno, sopra — parete.</string>
    <string name="home_item_floor_plank_note" formatted="false">Le assi scure di una stanza in affitto.</string>
    <string name="home_item_floor_light_note" formatted="false">Pino, quasi miele.</string>
    <string name="home_item_floor_dark_note" formatted="false">Quasi nero, brilla vicino alla finestra.</string>
    <string name="home_item_floor_herring_note" formatted="false">Come negli appartamenti di una volta.</string>
    <string name="home_item_floor_tile_note" formatted="false">Fresche, da cucina.</string>
    <string name="home_item_curtain_plum_note" formatted="false">Quelle già appese.</string>
    <string name="home_item_curtain_velvet_note" formatted="false">Come il sipario della Scala.</string>
    <string name="home_item_curtain_sand_note" formatted="false">Calde, di lino.</string>
    <string name="home_item_curtain_teal_note" formatted="false">Un verde-azzurro profondo.</string>
    <string name="home_item_curtain_tulle_note" formatted="false">Leggero, lascia passare la luce.</string>
    <string name="home_item_blinds_note" formatted="false">Di legno, a strisce di luce.</string>
    <string name="home_item_window_simple_note" formatted="false">Telaio a croce, com\'era.</string>
    <string name="home_item_window_arched_note" formatted="false">Il soffitto sembra più alto.</string>
    <string name="home_item_window_stained_note" formatted="false">Vetri colorati sopra la vista — la vista si indovina.</string>
    <string name="home_item_view_city_note" formatted="false">I tetti di fronte. La sera, la luna.</string>
    <string name="home_item_view_sea_note" formatted="false">L\'orizzonte e una sola vela.</string>
    <string name="home_item_view_mount_note" formatted="false">Neve sulle cime tutto l\'anno.</string>
    <string name="home_item_view_garden_note" formatted="false">Un prato e due alberi.</string>
    <string name="home_item_view_night_note" formatted="false">Finestre fino al cielo. Di giorno, solo vetro.</string>
    <string name="home_item_garland_note" formatted="false">Brillano la sera. Non solo d\'inverno.</string>
    <string name="home_item_lamp_table_note" formatted="false">Quella che c\'era. Fa luce la sera.</string>
    <string name="home_item_lamp_brass_note" formatted="false">Metallo caldo, luce calda.</string>
    <string name="home_item_floorlamp_note" formatted="false">Sta nell\'angolo e legge insieme a te.</string>
    <string name="home_item_chandelier_note" formatted="false">Cinque candele in cerchio. La sera sono accese.</string>
    <string name="home_item_candles_note" formatted="false">Tre, di altezze diverse. La sera sono vive.</string>
    <string name="home_item_fireplace_note" formatted="false">Solo in una casa con il camino. La sera arde, di giorno c\'è la legna.</string>
    <string name="home_item_desk_simple_note" formatted="false">Quattro gambe e un piano.</string>
    <string name="home_item_desk_oak_note" formatted="false">Piano spesso, maniglia di ottone.</string>
    <string name="home_item_bureau_note" formatted="false">Un tavolo su cui è cresciuta una parete di cassettini.</string>
    <string name="home_item_chair_simple_note" formatted="false">Di legno, scricchiola appena.</string>
    <string name="home_item_armchair_note" formatted="false">Profonda, rivestita di stoffa. Il gatto apprezzerà.</string>
    <string name="home_item_rocking_note" formatted="false">Dondola da sola, appena appena. Sempre.</string>
    <string name="home_item_plaid_note" formatted="false">Piegato, con le frange. Aspetta la sera.</string>
    <string name="home_item_pouf_note" formatted="false">Per sedersi un minuto con lo spartito.</string>
    <string name="home_item_bookshelf_note" formatted="false">Al soffitto non arriva, ma quasi.</string>
    <string name="home_item_commode_note" formatted="false">Tre cassetti. In quello in alto, le corde.</string>
    <string name="home_item_mirror_note" formatted="false">Per controllare l\'impostazione delle mani.</string>
    <string name="home_item_clock_note" formatted="false">Il pendolo oscilla. Le lancette seguono la tua ora.</string>
    <string name="home_item_rug_plum_note" formatted="false">Semplice, in tinta con le pareti. Il primo, e costa poco.</string>
    <string name="home_item_rug_persian_note" formatted="false">Bordeaux, con il bordo.</string>
    <string name="home_item_rug_stripe_note" formatted="false">Tessuto a mano, a righe.</string>
    <string name="home_item_rug_round_note" formatted="false">Piccolo, caldo.</string>
    <string name="home_item_rug_green_note" formatted="false">Come l\'erba in giardino.</string>
    <string name="home_item_ficus_note" formatted="false">Cresce piano, ma non appassisce mai.</string>
    <string name="home_item_monstera_note" formatted="false">Foglie traforate, grandi come una mano.</string>
    <string name="home_item_tulips_note" formatted="false">Tre. Non appassiscono — principio del gioco tranquillo.</string>
    <string name="home_item_vase_note" formatted="false">Fiori di campo. O del giardino sotto la finestra.</string>
    <string name="home_item_xmas_note" formatted="false">Stagionale: da dicembre a gennaio compare da solo, se è stato comprato.</string>
    <string name="home_item_tea_note" formatted="false">Il vapore sale sempre. Non si raffredda.</string>
    <string name="home_item_books_note" formatted="false">Tre. Uno parla di violino.</string>
    <string name="home_item_passport_note" formatted="false">Sta sul tavolo, quando non si è in viaggio.</string>
    <string name="home_item_globe_note" formatted="false">Una bandierina su ogni città dove sei stato. Si piantano da sole.</string>
    <string name="home_item_cat_ginger_note" formatted="false">Dorme sul davanzale. Respira, ogni tanto sbatte le palpebre. Non serve dargli da mangiare.</string>
    <string name="home_item_cat_black_note" formatted="false">Si vedono solo gli occhi — e non sempre.</string>
    <string name="home_item_cat_grey_note" formatted="false">Strisce in tinta con il pavimento.</string>
    <string name="home_item_cat_white_note" formatted="false">Sul tappeto scuro è come una macchia di luce.</string>
    <string name="home_item_dog_note" formatted="false">Sta sdraiato ai piedi. Ogni tanto alza la testa.</string>
    <string name="home_item_turtle_note" formatted="false">La più silenziosa di tutti. A volte si muove — non te ne accorgerai.</string>
    <string name="home_item_canary_note" formatted="false">Salta da un posatoio all\'altro. Non canta — principio 2.</string>
