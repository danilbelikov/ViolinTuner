    <string name="home_item_vln_student_note" formatted="false">A gift from the shop: the violin comes out of its case into the light.</string>
    <string name="home_item_vln_quarter_note" formatted="false">The very one it all began with. Small.</string>
    <string name="home_item_vln_light_note" formatted="false">The varnish has not darkened yet — it has not really sounded yet.</string>
    <string name="home_item_vln_master_note" formatted="false">One workshop, one pair of hands, half a year of work.</string>
    <string name="home_item_vln_electric_note" formatted="false">A frame instead of a body. It takes a moment to see it is a violin.</string>
    <string name="home_item_vln_old_note" formatted="false">Two hundred years of other people\'s hands. The varnish is almost black.</string>
    <string name="home_item_vln_cremona_note" formatted="false">Flamed maple on the back. It has a name, but nobody says it.</string>
    <string name="home_item_case_black_note" formatted="false">The one from the very beginning. It lies open by the window.</string>
    <string name="home_item_case_velvet_note" formatted="false">Severe outside, cherry inside.</string>
    <string name="home_item_case_carbon_note" formatted="false">As light as a glasses case.</string>
    <string name="home_item_case_leather_note" formatted="false">Stickers of the cities you have visited. They appear by themselves.</string>
    <string name="home_item_stand_fold_note" formatted="false">Metal, like the ones at school.</string>
    <string name="home_item_stand_concert_note" formatted="false">Black, heavy, with a wide shelf.</string>
    <string name="home_item_stand_wood_note" formatted="false">A lyre in the carving. From a Viennese shop.</string>
    <string name="home_item_stand_candle_note" formatted="false">In the evening the candles burn. By day they just stand there.</string>
    <string name="home_item_metronome_note" formatted="false">The pendulum always swings. Quietly.</string>
    <string name="home_item_notes_note" formatted="false">Everything you have read through, and everything you have not.</string>
    <string name="home_item_portrait_note" formatted="false">An oval, as in a conservatory. Who it is — you decide.</string>
    <string name="home_item_poster_note" formatted="false">The date is not set yet. The place is known.</string>
    <string name="home_item_postcards_note" formatted="false">The ones already unlocked. They appear by themselves, one per city.</string>
    <string name="home_item_shelf_scores_note" formatted="false">Spines in a row. It smells of paper.</string>
    <string name="home_item_gramophone_note" formatted="false">The horn faces the room. It does not play — this home keeps quiet.</string>
    <string name="home_item_radio_note" formatted="false">Valves and warm wood. Silent.</string>
    <string name="home_item_piano_note" formatted="false">A second instrument. The lid is open, the music is up.</string>
    <string name="home_item_cello_note" formatted="false">It leans against the wall. Sometimes you feel like it.</string>
    <string name="home_item_guitar_note" formatted="false">For days when the fingers want something else.</string>
    <string name="home_item_wp_plum_note" formatted="false">The ones that are there.</string>
    <string name="home_item_wp_warm_note" formatted="false">Plain, slightly warm.</string>
    <string name="home_item_wp_cool_note" formatted="false">Northern light.</string>
    <string name="home_item_wp_green_note" formatted="false">Like the velvet in a theatre box.</string>
    <string name="home_item_wp_stripe_note" formatted="false">A narrow stripe, a little lighter than the ground.</string>
    <string name="home_item_wp_damask_note" formatted="false">Diamonds with scrolls — here, diamonds.</string>
    <string name="home_item_wp_floral_note" formatted="false">Dots for flowers, pink on warm.</string>
    <string name="home_item_wp_notes_note" formatted="false">Tiny notes across the wall. They will not add up to a tune — just as well.</string>
    <string name="home_item_wp_panels_note" formatted="false">Wood up to the middle of the wall, wall above.</string>
    <string name="home_item_floor_plank_note" formatted="false">The dark boards of a rented room.</string>
    <string name="home_item_floor_light_note" formatted="false">Pine, almost honey.</string>
    <string name="home_item_floor_dark_note" formatted="false">Almost black, it gleams by the window.</string>
    <string name="home_item_floor_herring_note" formatted="false">As in old apartments.</string>
    <string name="home_item_floor_tile_note" formatted="false">Cool, like a kitchen.</string>
    <string name="home_item_curtain_plum_note" formatted="false">The ones that hang there.</string>
    <string name="home_item_curtain_velvet_note" formatted="false">Like the curtain at La Scala.</string>
    <string name="home_item_curtain_sand_note" formatted="false">Warm, linen.</string>
    <string name="home_item_curtain_teal_note" formatted="false">A deep blue-green.</string>
    <string name="home_item_curtain_tulle_note" formatted="false">Light, the sun comes through.</string>
    <string name="home_item_blinds_note" formatted="false">Wooden, in stripes of light.</string>
    <string name="home_item_window_simple_note" formatted="false">A cross of glazing bars, as it was.</string>
    <string name="home_item_window_arched_note" formatted="false">The ceiling seems to have risen.</string>
    <string name="home_item_window_stained_note" formatted="false">Coloured glass over the view — the view can be guessed.</string>
    <string name="home_item_view_city_note" formatted="false">The roofs opposite. In the evening, the moon.</string>
    <string name="home_item_view_sea_note" formatted="false">The horizon and a single sail.</string>
    <string name="home_item_view_mount_note" formatted="false">Snow on the peaks all year round.</string>
    <string name="home_item_view_garden_note" formatted="false">A lawn and two trees.</string>
    <string name="home_item_view_night_note" formatted="false">Windows up to the sky. By day — just glass.</string>
    <string name="home_item_garland_note" formatted="false">They twinkle in the evening. Not only in winter.</string>
    <string name="home_item_lamp_table_note" formatted="false">The one that was there. It shines in the evening.</string>
    <string name="home_item_lamp_brass_note" formatted="false">Warm metal, warm light.</string>
    <string name="home_item_floorlamp_note" formatted="false">It stands in the corner and reads along with you.</string>
    <string name="home_item_chandelier_note" formatted="false">Five candles in a circle. They burn in the evening.</string>
    <string name="home_item_candles_note" formatted="false">Three, of different heights. Alive in the evening.</string>
    <string name="home_item_fireplace_note" formatted="false">Only in a home with a chimney. A fire in the evening, logs by day.</string>
    <string name="home_item_desk_simple_note" formatted="false">Four legs and a top.</string>
    <string name="home_item_desk_oak_note" formatted="false">A thick top, a brass handle.</string>
    <string name="home_item_bureau_note" formatted="false">A desk that has grown a wall of little drawers.</string>
    <string name="home_item_chair_simple_note" formatted="false">Wooden, creaks a little.</string>
    <string name="home_item_armchair_note" formatted="false">Deep, upholstered. The cat will approve.</string>
    <string name="home_item_rocking_note" formatted="false">It rocks by itself, just a little. Always.</string>
    <string name="home_item_plaid_note" formatted="false">Folded, with a fringe. Waiting for the evening.</string>
    <string name="home_item_pouf_note" formatted="false">To sit down for a minute with the music.</string>
    <string name="home_item_bookshelf_note" formatted="false">It does not reach the ceiling, but it is close.</string>
    <string name="home_item_commode_note" formatted="false">Three drawers. Strings in the top one.</string>
    <string name="home_item_mirror_note" formatted="false">For checking your posture and hands.</string>
    <string name="home_item_clock_note" formatted="false">The pendulum swings. The hands keep your time.</string>
    <string name="home_item_rug_plum_note" formatted="false">Simple, matching the walls. The first one, and not dear.</string>
    <string name="home_item_rug_persian_note" formatted="false">Burgundy, with a border.</string>
    <string name="home_item_rug_stripe_note" formatted="false">Handwoven, striped.</string>
    <string name="home_item_rug_round_note" formatted="false">Small and warm.</string>
    <string name="home_item_rug_green_note" formatted="false">Like the grass in a garden.</string>
    <string name="home_item_ficus_note" formatted="false">It grows slowly but never wilts.</string>
    <string name="home_item_monstera_note" formatted="false">Leaves with slits, the size of a palm.</string>
    <string name="home_item_tulips_note" formatted="false">Three of them. They never wilt — this is a quiet game.</string>
    <string name="home_item_vase_note" formatted="false">Wild flowers. Or from the garden under the window.</string>
    <string name="home_item_xmas_note" formatted="false">Seasonal: once bought, it stands by itself from December to January.</string>
    <string name="home_item_tea_note" formatted="false">Always steaming. It never goes cold.</string>
    <string name="home_item_books_note" formatted="false">Three. One is about the violin.</string>
    <string name="home_item_passport_note" formatted="false">It lies on the desk when you are not on the road.</string>
    <string name="home_item_globe_note" formatted="false">A flag on every city you have been to. They place themselves.</string>
    <string name="home_item_cat_ginger_note" formatted="false">Asleep on the windowsill. It breathes and blinks now and then. No feeding needed.</string>
    <string name="home_item_cat_black_note" formatted="false">Only the eyes show — and not always.</string>
    <string name="home_item_cat_grey_note" formatted="false">Stripes to match the floor.</string>
    <string name="home_item_cat_white_note" formatted="false">On a dark rug — like a patch of light.</string>
    <string name="home_item_dog_note" formatted="false">It lies at your feet. Sometimes it lifts its head.</string>
    <string name="home_item_turtle_note" formatted="false">The quietest of all. Sometimes it moves — you will not notice.</string>
    <string name="home_item_canary_note" formatted="false">It hops from perch to perch. It does not sing — this home keeps quiet.</string>
    <string name="home_item_aquarium_note" formatted="false">One fish swims to and fro. The water never clouds.</string>
    <string name="home_item_parrot_note" formatted="false">Green and red. It looks out of the window.</string>
    <string name="home_item_mailbox_note" formatted="false">The flag is up — a postcard has come.</string>
    <string name="home_item_lantern_note" formatted="false">It lights up with the evening.</string>
    <string name="home_item_bench_note" formatted="false">To sit with the case before the road.</string>
    <string name="home_item_bike_note" formatted="false">Leaning against the house. Going nowhere.</string>
    <string name="home_item_flowerbed_note" formatted="false">Something is always in bloom.</string>
    <string name="home_item_swing_note" formatted="false">It sways in the wind even when nobody is there.</string>
    <string name="home_item_feeder_note" formatted="false">The birds come by themselves. The seed never runs out.</string>
    <string name="home_item_vane_note" formatted="false">It shows where the wind is from. Here it is always a fair one.</string>
    <string name="home_item_car_old_note" formatted="false">Starts on the third try. Cherry-coloured.</string>
    <string name="home_item_car_wagon_note" formatted="false">A cello fits. Tested.</string>
    <string name="home_item_car_cabrio_note" formatted="false">The top is always down. It never rains here.</string>
