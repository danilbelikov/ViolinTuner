    <string name="home_item_vln_student_note" formatted="false">Cadeau de la boutique : le violon sort de son étui, à la lumière.</string>
    <string name="home_item_vln_quarter_note" formatted="false">Celui par qui tout a commencé. Tout petit.</string>
    <string name="home_item_vln_light_note" formatted="false">Le vernis n\'a pas encore foncé — il n\'a pas encore vraiment sonné.</string>
    <string name="home_item_vln_master_note" formatted="false">Un seul atelier, une seule paire de mains, six mois de travail.</string>
    <string name="home_item_vln_electric_note" formatted="false">Un cadre à la place de la caisse. On ne voit pas tout de suite que c\'est un violon.</string>
    <string name="home_item_vln_old_note" formatted="false">Deux cents ans passés entre d\'autres mains. Un vernis presque noir.</string>
    <string name="home_item_vln_cremona_note" formatted="false">Érable flammé au dos. Il a un nom, mais on ne le prononce pas.</string>
    <string name="home_item_case_black_note" formatted="false">Celui du tout début. Il reste ouvert près de la fenêtre.</string>
    <string name="home_item_case_velvet_note" formatted="false">Sobre dehors, cerise dedans.</string>
    <string name="home_item_case_carbon_note" formatted="false">Léger comme un étui à lunettes.</string>
    <string name="home_item_case_leather_note" formatted="false">Les étiquettes des villes où vous êtes passé. Elles apparaissent toutes seules.</string>
    <string name="home_item_stand_fold_note" formatted="false">En métal, comme à l\'école.</string>
    <string name="home_item_stand_concert_note" formatted="false">Noir, lourd, à large tablette.</string>
    <string name="home_item_stand_wood_note" formatted="false">Une lyre sculptée. Vient d\'une boutique viennoise.</string>
    <string name="home_item_stand_candle_note" formatted="false">Le soir, les bougies brûlent. Le jour, elles sont là, simplement.</string>
    <string name="home_item_metronome_note" formatted="false">Le balancier oscille toujours. En silence.</string>
    <string name="home_item_notes_note" formatted="false">Tout ce qui est déchiffré, et ce qui ne l\'est pas encore.</string>
    <string name="home_item_portrait_note" formatted="false">Un ovale, comme au conservatoire. Qui est-ce ? À vous de décider.</string>
    <string name="home_item_poster_note" formatted="false">La date n\'est pas encore fixée. Le lieu, lui, est connu.</string>
    <string name="home_item_postcards_note" formatted="false">Celles déjà ouvertes. Elles arrivent toutes seules, une par ville.</string>
    <string name="home_item_shelf_scores_note" formatted="false">Des dos bien alignés. Ça sent le papier.</string>
    <string name="home_item_gramophone_note" formatted="false">Le pavillon regarde la pièce. Il ne joue pas — principe n° 2.</string>
    <string name="home_item_radio_note" formatted="false">À lampes, en bois chaleureux. Elle se tait.</string>
    <string name="home_item_piano_note" formatted="false">Le second instrument. Couvercle ouvert, partition en place.</string>
    <string name="home_item_cello_note" formatted="false">Appuyé contre le mur. Parfois, on en a envie.</string>
    <string name="home_item_guitar_note" formatted="false">Pour les jours où les doigts ont envie d\'autre chose.</string>
    <string name="home_item_wp_plum_note" formatted="false">Ceux qui étaient là.</string>
    <string name="home_item_wp_warm_note" formatted="false">Unis, légèrement chauds.</string>
    <string name="home_item_wp_cool_note" formatted="false">Lumière du nord.</string>
    <string name="home_item_wp_green_note" formatted="false">Comme le velours d\'une loge.</string>
    <string name="home_item_wp_stripe_note" formatted="false">Rayure fine, à peine plus claire que le fond.</string>
    <string name="home_item_wp_damask_note" formatted="false">Des lys et des volutes, un ton plus clair que le fond.</string>
    <string name="home_item_wp_floral_note" formatted="false">Des fleurs en pointillé, roses sur fond chaud.</string>
    <string name="home_item_wp_notes_note" formatted="false">De petites notes sur le mur. Elles ne forment aucune mélodie — tant mieux.</string>
    <string name="home_item_wp_panels_note" formatted="false">Du bois jusqu\'à mi-hauteur, le mur au-dessus.</string>
    <string name="home_item_floor_plank_note" formatted="false">Le plancher sombre de la chambre louée.</string>
    <string name="home_item_floor_light_note" formatted="false">Du pin, presque du miel.</string>
    <string name="home_item_floor_dark_note" formatted="false">Presque noir, il brille près de la fenêtre.</string>
    <string name="home_item_floor_herring_note" formatted="false">Comme dans les vieux appartements.</string>
    <string name="home_item_floor_tile_note" formatted="false">Frais, façon cuisine.</string>
    <string name="home_item_curtain_plum_note" formatted="false">Ceux qui étaient accrochés.</string>
    <string name="home_item_curtain_velvet_note" formatted="false">Comme le rideau de la Scala.</string>
    <string name="home_item_curtain_sand_note" formatted="false">Chauds, en lin.</string>
    <string name="home_item_curtain_teal_note" formatted="false">Un bleu-vert profond.</string>
    <string name="home_item_curtain_tulle_note" formatted="false">Léger, il laisse passer la lumière.</string>
    <string name="home_item_blinds_note" formatted="false">En bois, la lumière en lames.</string>
    <string name="home_item_window_simple_note" formatted="false">Des croisillons, comme avant.</string>
    <string name="home_item_window_arched_note" formatted="false">On dirait que le plafond a pris de la hauteur.</string>
    <string name="home_item_window_stained_note" formatted="false">Des verres colorés devant la vue — on la devine.</string>
    <string name="home_item_view_city_note" formatted="false">Les toits d\'en face. Le soir, la lune.</string>
    <string name="home_item_view_sea_note" formatted="false">L\'horizon et une seule voile.</string>
    <string name="home_item_view_mount_note" formatted="false">De la neige sur les sommets toute l\'année.</string>
    <string name="home_item_view_garden_note" formatted="false">Une pelouse et deux arbres.</string>
    <string name="home_item_view_night_note" formatted="false">Des fenêtres jusqu\'au ciel. Le jour, ce n\'est que du verre.</string>
    <string name="home_item_garland_note" formatted="false">Elle scintille le soir. Pas seulement en hiver.</string>
    <string name="home_item_lamp_table_note" formatted="false">Celle qui était là. Elle éclaire le soir.</string>
    <string name="home_item_lamp_brass_note" formatted="false">Métal chaud, lumière chaude.</string>
    <string name="home_item_floorlamp_note" formatted="false">Dans son coin, il lit avec vous.</string>
    <string name="home_item_chandelier_note" formatted="false">Cinq bougies en cercle. Le soir, elles brûlent.</string>
    <string name="home_item_candles_note" formatted="false">Trois, de hauteurs différentes. Le soir, elles vivent.</string>
    <string name="home_item_fireplace_note" formatted="false">Seulement dans une maison à cheminée. Le soir, le feu ; le jour, les bûches.</string>
    <string name="home_item_desk_simple_note" formatted="false">Quatre pieds et un plateau.</string>
    <string name="home_item_desk_oak_note" formatted="false">Plateau épais, poignée en laiton.</string>
    <string name="home_item_bureau_note" formatted="false">Une table sur laquelle a poussé un mur de petits tiroirs.</string>
    <string name="home_item_chair_simple_note" formatted="false">En bois, elle grince un peu.</string>
    <string name="home_item_armchair_note" formatted="false">Profond, tapissé de tissu. Le chat appréciera.</string>
    <string name="home_item_rocking_note" formatted="false">Il se balance tout seul, à peine. Toujours.</string>
    <string name="home_item_plaid_note" formatted="false">Plié, à franges. Il attend le soir.</string>
    <string name="home_item_pouf_note" formatted="false">Pour s\'asseoir une minute avec la partition.</string>
    <string name="home_item_bookshelf_note" formatted="false">Elle ne touche pas le plafond, mais presque.</string>
    <string name="home_item_commode_note" formatted="false">Trois tiroirs. Dans celui du haut, les cordes.</string>
    <string name="home_item_mirror_note" formatted="false">Pour vérifier la tenue des mains.</string>
    <string name="home_item_clock_note" formatted="false">Le balancier oscille. Les aiguilles sont à votre heure.</string>
    <string name="home_item_rug_plum_note" formatted="false">Simple, assorti aux murs. Le premier, et pas cher.</string>
    <string name="home_item_rug_persian_note" formatted="false">Bordeaux, avec sa bordure.</string>
    <string name="home_item_rug_stripe_note" formatted="false">Tissé main, à rayures.</string>
    <string name="home_item_rug_round_note" formatted="false">Petit et chaleureux.</string>
    <string name="home_item_rug_green_note" formatted="false">Comme l\'herbe du jardin.</string>
    <string name="home_item_ficus_note" formatted="false">Il pousse lentement, mais ne fane jamais.</string>
    <string name="home_item_monstera_note" formatted="false">Des feuilles ajourées, grandes comme la main.</string>
    <string name="home_item_tulips_note" formatted="false">Trois. Elles ne fanent pas — principe du jeu tranquille.</string>
    <string name="home_item_vase_note" formatted="false">Des fleurs des champs. Ou du jardin sous la fenêtre.</string>
    <string name="home_item_xmas_note" formatted="false">De saison : de décembre à janvier, il se dresse tout seul, s\'il est acheté.</string>
    <string name="home_item_tea_note" formatted="false">Elle fume toujours. Elle ne refroidit pas.</string>
    <string name="home_item_books_note" formatted="false">Trois. L\'un parle du violon.</string>
    <string name="home_item_passport_note" formatted="false">Il reste sur la table quand vous n\'êtes pas en route.</string>
    <string name="home_item_globe_note" formatted="false">Un drapeau sur chaque ville où vous êtes passé. Ils se plantent tout seuls.</string>
    <string name="home_item_cat_ginger_note" formatted="false">Il dort sur le rebord de la fenêtre. Il respire, cligne parfois des yeux. Inutile de le nourrir.</string>
    <string name="home_item_cat_black_note" formatted="false">On ne voit que ses yeux — et encore, pas toujours.</string>
    <string name="home_item_cat_grey_note" formatted="false">Des rayures assorties au sol.</string>
    <string name="home_item_cat_white_note" formatted="false">Sur un tapis sombre, comme une tache de lumière.</string>
    <string name="home_item_dog_note" formatted="false">Couché à vos pieds. Parfois, il lève la tête.</string>
    <string name="home_item_turtle_note" formatted="false">La plus silencieuse de tous. Elle bouge parfois — vous ne le remarquerez pas.</string>
    <string name="home_item_canary_note" formatted="false">Il saute de perchoir en perchoir. Il ne chante pas — principe n° 2.</string>
    <string name="home_item_aquarium_note" formatted="false">Un seul poisson, qui va et vient. L\'eau ne se trouble pas.</string>
    <string name="home_item_parrot_note" formatted="false">Vert et rouge. Il regarde par la fenêtre.</string>
    <string name="home_item_mailbox_note" formatted="false">Drapeau levé — une carte postale est arrivée.</string>
    <string name="home_item_lantern_note" formatted="false">Elle s\'allume avec le soir.</string>
    <string name="home_item_bench_note" formatted="false">Pour s\'asseoir avec l\'étui avant de partir.</string>
    <string name="home_item_bike_note" formatted="false">Appuyé contre la maison. Il ne va nulle part.</string>
    <string name="home_item_flowerbed_note" formatted="false">Il y a toujours quelque chose en fleur.</string>
    <string name="home_item_swing_note" formatted="false">Elle se balance au vent, même quand il n\'y a personne.</string>
    <string name="home_item_feeder_note" formatted="false">Les oiseaux viennent d\'eux-mêmes. Les graines ne manquent jamais.</string>
    <string name="home_item_vane_note" formatted="false">Elle montre d\'où vient le vent. Ici, il est toujours favorable.</string>
    <string name="home_item_car_old_note" formatted="false">Elle démarre au troisième essai. Couleur cerise.</string>
    <string name="home_item_car_wagon_note" formatted="false">Le violoncelle rentre. Vérifié.</string>
    <string name="home_item_car_cabrio_note" formatted="false">La capote est toujours repliée. Ici, il ne pleut jamais.</string>
