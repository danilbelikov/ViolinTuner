    <string name="home_item_car_wagon_note" formatted="false">Ein Cello passt hinein. Geprüft.</string>
    <string name="home_item_car_cabrio_note" formatted="false">Das Verdeck ist immer offen. Regen gibt es hier nicht.</string>
